# Debug mode: if true, saves images to debug_output/ instead of updating e-ink display
DEBUG=false

# MTA Subway configuration
# Station ID for train arrivals (e.g., "F19S" for a specific station)
STATION_ID=your_station_id

# Train lines to monitor (e.g., "F", "G")
TRAIN_LINE_1=F
TRAIN_LINE_2=G

# Weather configuration (optional - defaults to NYC coordinates)
# Open-Meteo API is used - no API key required!
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060

# Quiet mode: if true, suppresses console output
QUIET_MODE=false

# Weather layout debugging (optional)
# WEATHER_DEBUG_LAYOUT="morning"

# Citi Bike configuration
# Find your station's UUID + name in the GBFS feed:
# https://gbfs.citibikenyc.com/gbfs/en/station_information.json
CITIBIKE_STATION_ID=your_citibike_station_uuid
CITIBIKE_STATION_NAME=Your Station Name

# Historical data capture
# Keep enabled if you want long-term bike/train/weather history for later analysis.
DATA_COLLECTION_ENABLED=true
# SQLite file location on device (directory will be created automatically).
HISTORY_DB_PATH=data/history.db
# Local timezone used for day/hour/week buckets in reports.
HISTORY_TIMEZONE=America/New_York
# Time bucket size used across all history tables for easy joins.
HISTORY_BUCKET_MINUTES=5
